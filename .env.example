# PostgreSQL connection (adjust user, password, host, database name)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mishka_db?schema=public"

# HTTP port for this Express server
PORT=3000

# Allowed origins for CORS, comma-separated. Use * only in controlled environments.
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# JWT settings
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# When rememberMe is true on login/register, session/JWT uses this expiry (jsonwebtoken string, e.g. 30d)
JWT_REMEMBER_ME_EXPIRES_IN="30d"

# Signup OTP: if true, POST /auth/register must include signupOtp from POST /auth/send-signup-otp
SIGNUP_OTP_REQUIRED=false
# Dev only: include signup OTP in JSON (never enable in production)
RETURN_SIGNUP_OTP_IN_RESPONSE=false
# Temporary: signupOtp matching this value skips DB check (default 111111). Set DISABLE_SIGNUP_OTP_BYPASS=true in production.
# SIGNUP_OTP_BYPASS_CODE=111111
# DISABLE_SIGNUP_OTP_BYPASS=false

# OAuth (optional) — required for POST /auth/oauth/*
# GOOGLE_OAUTH_CLIENT_IDS="your-android-client.apps.googleusercontent.com,your-web-client.apps.googleusercontent.com"
# APPLE_CLIENT_IDS="com.your.app,com.your.app.service"
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Upstream AI service used by /upload, /chat, /generate-tools
AI_SERVICE_URL="http://127.0.0.1:8000"

# Where Node stores a copy of each uploaded file (relative to project dir, or absolute path)
AI_UPLOAD_STORAGE_DIR="data/ai-uploads"

# Set to "development" to include error details in JSON responses
NODE_ENV=development

# Dev only: include resetCode in forgot-password response (do not enable in production)
RETURN_RESET_CODE_IN_RESPONSE=false

# OpenAPI UI at /api-docs (set to true to hide Swagger in production)
# DISABLE_SWAGGER=false

# Optional: base URL shown in Swagger "Try it out" (defaults to http://127.0.0.1:$PORT)
# SWAGGER_SERVER_URL=http://localhost:3000
