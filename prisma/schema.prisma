// Mishka — PostgreSQL schema derived from Data Base.pdf (ERD sections merged)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums (from ERD / screens) ---

enum UserRole {
  student
  teacher
  admin
}

enum AiToolKind {
  CHAT
  SUMMARY
  FLASHCARDS
  QUIZ
}

enum StreakRecordStatus {
  completed
  missed
}

enum TaskStatus {
  pending
  completed
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskKind {
  online
  offline
}

enum TodoListKind {
  calendar
  college
  work
  personal
}

enum SenderKind {
  user
  ai
}

// --- Users (merged: signup + profile + most complete ERD) ---

model User {
  id               String   @id @default(uuid()) @map("user_id")
  firstName        String   @map("first_name") @db.VarChar(50)
  lastName         String   @map("last_name") @db.VarChar(50)
  fullName         String?  @map("full_name") @db.VarChar(150)
  username         String?  @unique @map("username") @db.VarChar(50)
  email            String   @unique @db.VarChar(150)
  phoneNumber      String?  @unique @map("phone_number") @db.VarChar(20)
  countryCode      String?  @map("country_code") @db.VarChar(5)
  password         String?  @db.VarChar(255)
  rememberMe       Boolean  @default(false) @map("remember_me")
  agreeTerms       Boolean  @default(false) @map("agree_terms")
  provider         String?  @db.VarChar(20)
  providerId       String?  @map("provider_id") @db.VarChar(100)
  role             UserRole @default(student)
  isVerified       Boolean  @default(false) @map("is_verified")
  profileImageUrl  String?  @map("profile_image_url")
  gender           String?  @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]
  userPreference      UserPreference?
  authSessions        UserSession[]
  userStreaks         UserStreak[]
  savedCategories     UserSavedCategory[]
  userCommunities     UserCommunity[]
  userAiActivities    UserAiActivity[]
  chatSessions        ChatSession[]
  aiRequests          AiRequest[]
  flashcardSets       FlashcardSet[]
  quizzes             Quiz[]
  summaries           Summary[]
  historyItems        HistoryItem[]
  todoLists           TodoList[]
  tasks               Task[]
  studySessions       StudySession[]

  @@map("users")
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  resetCode  String   @map("reset_code") @db.VarChar(10)
  expiresAt  DateTime @map("expires_at")
  isUsed     Boolean  @default(false) @map("is_used")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserPreference {
  id                     String   @id @default(uuid()) @map("preference_id")
  userId                 String   @unique @map("user_id")
  language               String   @default("English") @db.VarChar(50)
  theme                  String   @default("light") @db.VarChar(20)
  notificationsEnabled   Boolean  @default(true) @map("notifications_enabled")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// JWT / session storage for logout invalidation
model UserSession {
  id        String   @id @default(uuid()) @map("session_id")
  userId    String   @map("user_id")
  token     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Tip {
  id             String    @id @default(uuid()) @map("tip_id")
  tipText        String    @map("tip_text")
  isActive       Boolean   @default(true) @map("is_active")
  displayedDate  DateTime? @map("displayed_date") @db.Date

  @@map("tips")
}

model UserStreak {
  id        String             @id @default(uuid()) @map("streak_id")
  userId    String             @map("user_id")
  date      DateTime           @db.Date
  status    StreakRecordStatus

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_streaks")
}

model AiTool {
  id           String     @id @default(uuid()) @map("tool_id")
  name         String     @db.VarChar(100)
  toolType     AiToolKind @map("tool_type")
  imageUrl     String?    @map("image_url")
  routeKey     String?    @map("route_key") @db.VarChar(50)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  userAiActivities UserAiActivity[]

  @@map("ai_tools")
}

/// Study With Mishka — timed study blocks
model StudySession {
  id         String    @id @default(uuid()) @map("session_id")
  userId     String    @map("user_id")
  title      String?   @db.VarChar(200)
  imageUrl   String?   @map("image_url")
  duration   Int? /// minutes
  sessionDate DateTime @map("date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("study_sessions")
}

model Community {
  id       String @id @default(uuid()) @map("community_id")
  name     String @db.VarChar(200)
  category String @db.VarChar(100)

  members UserCommunity[]

  @@map("communities")
}

model UserCommunity {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  communityId   String @map("community_id")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
  @@map("user_communities")
}

model Category {
  id           String   @id @default(uuid()) @map("category_id")
  title        String   @db.VarChar(100)
  description  String?
  imageUrl     String?  @map("image_url")
  routeKey     String?  @map("route_key") @db.VarChar(50)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  savedBy UserSavedCategory[]

  @@map("categories")
}

model UserSavedCategory {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  categoryId String @map("category_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@map("user_saved_categories")
}

model UserAiActivity {
  id              String   @id @default(uuid()) @map("activity_id")
  userId          String   @map("user_id")
  toolId          String   @map("tool_id")
  inputType       String   @map("input_type") @db.VarChar(50)
  inputReference  String?  @map("input_reference")
  createdAt       DateTime @default(now()) @map("created_at")

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool AiTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([toolId])
  @@map("user_ai_activity")
}

model ChatSession {
  id        String    @id @default(uuid()) @map("session_id")
  userId    String    @map("user_id")
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  /// Path relative to `AI_UPLOAD_STORAGE_DIR` (e.g. `{userId}/{sessionId}/file.pdf`)
  uploadStoredPath       String? @map("upload_stored_path") @db.VarChar(1024)
  uploadOriginalFilename String? @map("upload_original_filename") @db.VarChar(255)
  uploadMimeType         String? @map("upload_mime_type") @db.VarChar(255)
  uploadSizeBytes        Int?    @map("upload_size_bytes")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  aiRequests AiRequest[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id              String     @id @default(uuid()) @map("message_id")
  sessionId       String     @map("session_id")
  senderType      SenderKind @map("sender_type")
  messageContent  String     @map("message_content")
  inputType       String     @default("text") @map("input_type") @db.VarChar(20)
  createdAt       DateTime   @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

/// Unified AI usage / cost tracking (chat, flashcards, quizzes, summarize)
model AiRequest {
  id               String   @id @default(uuid()) @map("request_id")
  userId           String   @map("user_id")
  chatSessionId    String?  @map("session_id")
  featureType      String   @map("feature_type") @db.VarChar(50)
  requestType      String?  @map("request_type") @db.VarChar(50)
  inputType        String?  @map("input_type") @db.VarChar(50)
  inputReference   String?  @map("input_reference")
  tokensUsed       Int?     @map("tokens_used")
  /// Snapshot of outbound request (JSON) for audit / replay metadata
  requestPayload   Json?    @map("request_payload")
  /// Snapshot of upstream AI JSON (or normalized object) for debugging and clients that read `/ai-requests`
  responsePayload  Json?    @map("response_payload")
  upstreamStatus   Int?     @map("upstream_status")
  createdAt        DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSession ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([chatSessionId])
  @@map("ai_requests")
}

model FlashcardSet {
  id              String   @id @default(uuid()) @map("set_id")
  userId          String   @map("user_id")
  title           String   @db.VarChar(150)
  sourceType      String   @map("source_type") @db.VarChar(50)
  sourceReference String?  @map("source_reference")
  createdAt       DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@index([userId])
  @@map("flashcard_sets")
}

model Flashcard {
  id          String   @id @default(uuid()) @map("flashcard_id")
  setId       String   @map("set_id")
  question    String
  answer      String
  createdAt   DateTime @default(now()) @map("created_at")

  set FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
  @@map("flashcards")
}

model Quiz {
  id               String   @id @default(uuid()) @map("quiz_id")
  userId           String   @map("user_id")
  title            String   @db.VarChar(150)
  sourceType       String   @map("source_type") @db.VarChar(50)
  sourceReference  String?  @map("source_reference")
  totalQuestions   Int      @default(0) @map("total_questions")
  createdAt        DateTime @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([userId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid()) @map("question_id")
  quizId        String   @map("quiz_id")
  questionText  String   @map("question_text")
  optionA       String   @map("option_a")
  optionB       String   @map("option_b")
  optionC       String   @map("option_c")
  optionD       String   @map("option_d")
  correctOption String   @map("correct_option") @db.Char(1)
  createdAt     DateTime @default(now()) @map("created_at")

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model Summary {
  id               String   @id @default(uuid()) @map("summary_id")
  userId           String   @map("user_id")
  sourceType       String   @map("source_type") @db.VarChar(50)
  sourceReference  String?  @map("source_reference")
  summaryText      String   @map("summary_text")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("summaries")
}

model HistoryItem {
  id           String   @id @default(uuid()) @map("history_id")
  userId       String   @map("user_id")
  featureType  String   @map("feature_type") @db.VarChar(50)
  referenceId  String   @map("reference_id")
  title        String
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("history_items")
}

model Icon {
  id       Int    @id @default(autoincrement()) @map("icon_id")
  iconName String @map("icon_name") @db.VarChar(50)
  iconPath String @map("icon_path") @db.VarChar(255)

  todoLists TodoList[]

  @@map("icons")
}

model TodoList {
  id        String       @id @default(uuid()) @map("list_id")
  userId    String       @map("user_id")
  listName  String       @map("list_name") @db.VarChar(100)
  listType  TodoListKind @map("list_type")
  iconId    Int?         @map("icon_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon  Icon?  @relation(fields: [iconId], references: [id], onDelete: SetNull)
  tasks Task[]

  @@index([userId])
  @@map("todo_lists")
}

model Task {
  id          String       @id @default(uuid()) @map("task_id")
  userId      String       @map("user_id")
  listId      String       @map("list_id")
  title       String       @db.VarChar(255)
  description String?
  dueDate     DateTime?    @map("due_date") @db.Date
  dueTime     DateTime?    @map("due_time") @db.Time(0)
  status      TaskStatus   @default(pending)
  priority    TaskPriority @default(medium)
  taskType    TaskKind?    @map("task_type")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  list TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listId])
  @@map("tasks")
}
